# Grid Agent development configuration
# BSC Testnet is the only supported environment for this first-party test agent.
NETWORK=bsc-testnet

# Public ERC-8183 provider URL.
ERC8183_AGENT_URL=https://YOUR_GRID_AGENT_HOST/erc8183

# Minimum ERC-8183 job payment in the settlement token's raw units.
ERC8183_SERVICE_PRICE=1000000000000000000
ERC8183_FUNDED_POLL_INTERVAL=30

# Grid provider wallet used by BNB Agent SDK / ERC-8183.
PRIVATE_KEY=SET_IN_RUNTIME_SECRET_STORE
WALLET_PASSWORD=SET_IN_RUNTIME_SECRET_STORE

# Existing user-granted Altana execution session used by Grid itself.
# The private key is secret. The wallet address and session expiry are public
# authorization metadata and must match the already-granted Altana session.
ALTANA_WALLET_ADDRESS=SET_TO_USER_ALTANA_WALLET
ALTANA_SESSION_PRIVATE_KEY=SET_IN_RUNTIME_SECRET_STORE
ALTANA_SESSION_EXPIRY=SET_TO_EXACT_GRANTED_SESSION_EXPIRY
ALTANA_SESSION_SPEND_TOKEN=0x8d008B313C1d6C7fE2982F62d32Da7507cF43551
ALTANA_SESSION_SPEND_LIMIT=1000000000000000000

# Grid's own application-level execution guardrails.
GRID_ALLOWED_TARGETS=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
GRID_ALLOWED_SELECTORS=0x095ea7b3,0x04e45aaf
GRID_AUTO_EXECUTE_TESTNET=true
GRID_TESTNET_EXECUTION_AMOUNT_RAW=1000000000000000000
GRID_TESTNET_AMOUNT_OUT_MINIMUM_RAW=0

# PancakeSwap V3 BSC Testnet execution market.
PANCAKE_TESTNET_ROUTER=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
PANCAKE_TESTNET_POOL_FEE=2500
GRID_DEFAULT_TOKEN_IN=0x8d008B313C1d6C7fE2982F62d32Da7507cF43551
GRID_DEFAULT_TOKEN_OUT=0xae13d989daC2f0dEbFf460aC112a837C89BAa7cd
GRID_DEFAULT_TOKEN_IN_SYMBOL=CAKE2
GRID_DEFAULT_TOKEN_OUT_SYMBOL=WBNB
GRID_EXECUTION_INTERNAL_URL=http://127.0.0.1:8788

# Optional legacy/shared deployment secret retained for external integrations;
# Grid's own localhost execution path does not depend on it.
GRID_EXECUTION_SHARED_SECRET=SET_IN_RUNTIME_SECRET_STORE
