# Grid Agent development configuration
# Use BSC Testnet while validating the marketplace lifecycle.
NETWORK=bsc-testnet

# Public URL must include /erc8183 when using the local storage provider.
ERC8183_AGENT_URL=https://YOUR_GRID_AGENT_HOST/erc8183

# Minimum acceptable ERC-8183 budget in raw payment-token units.
ERC8183_SERVICE_PRICE=1000000000000000000

# Poll for funded jobs every 30 seconds.
ERC8183_FUNDED_POLL_INTERVAL=30

# Optional wallet configuration for the provider runtime.
PRIVATE_KEY=SET_IN_RUNTIME_SECRET_STORE
WALLET_PASSWORD=SET_IN_RUNTIME_SECRET_STORE

# Embedded Altana execution adapter. Keep these only in the runtime secret store.
GRID_EXECUTION_SHARED_SECRET=SET_IN_RUNTIME_SECRET_STORE
ALTANA_SESSION_PRIVATE_KEY=SET_IN_RUNTIME_SECRET_STORE
GRID_ALLOWED_TARGETS=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
GRID_ALLOWED_SELECTORS=0x095ea7b3,0x04e45aaf
PANCAKE_TESTNET_ROUTER=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
PANCAKE_TESTNET_POOL_FEE=500
GRID_EXECUTION_INTERNAL_URL=http://127.0.0.1:8788
GRID_EXECUTION_ENDPOINT_URL=https://YOUR_GRID_AGENT_HOST/erc8183
