# Dedicated Grid execution service; BSC Testnet only (chain 97)
PORT=8788
ALTANA_SESSION_PRIVATE_KEY=0x

# Fail-closed Risk Guardian configuration.
# Targets must also be present in the user's on-chain Altana session allowlist.
GRID_ALLOWED_TARGETS=0xYourPancakeSwapTestnetRouter
# Comma-separated 4-byte function selectors. Keep this explicit; empty means reject all execution.
GRID_ALLOWED_SELECTORS=0x00000000
