# Dedicated Grid execution service; BSC Testnet only (chain 97)
PORT=8788
ALTANA_SESSION_PRIVATE_KEY=0x

# Native BNB gas-recovery spend permission registered with the same Altana session grant.
ALTANA_SESSION_NATIVE_SPEND_LIMIT=20000000000000000

# Grid Testnet execution is locked to the canonical CAKE2/WBNB market.
GRID_DEFAULT_TOKEN_IN=0x8d008B313C1d6C7fE2982F62d32Da7507cF43551
GRID_DEFAULT_TOKEN_IN_SYMBOL=CAKE2
GRID_DEFAULT_TOKEN_OUT=0xae13d989daC2f0dEbFf460aC112a837C89BAa7cd
GRID_DEFAULT_TOKEN_OUT_SYMBOL=WBNB
PANCAKE_TESTNET_ROUTER=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
PANCAKE_TESTNET_POOL_FEE=2500

# Fail-closed Risk Guardian configuration.
# Targets must also be present in the user's on-chain Altana session allowlist.
GRID_ALLOWED_TARGETS=0x9a489505a00cE272eAa5e07Dba6491314CaE3796
# Comma-separated 4-byte function selectors used by the Testnet call builder.
# ERC-20 approval + PancakeSwap V3 exactInputSingle.
GRID_ALLOWED_SELECTORS=0x095ea7b3,0x04e45aaf
