FROM python:3.12-slim

WORKDIR /app

COPY agents/grid/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && python -m pip install --no-cache-dir uvicorn fastapi

COPY agents/grid/ ./agents/grid/

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app/agents/grid

CMD ["python", "-m", "uvicorn", "app.service.main:app", "--host", "0.0.0.0", "--port", "8080"]
