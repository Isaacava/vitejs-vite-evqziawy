{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmarket.xyz/schemas/agent-provider-manifest-v1.schema.json",
  "title": "Agent Provider Manifest v1",
  "description": "Machine-readable contract describing how a client can discover, hire, and invoke an independently hosted agent.",
  "type": "object",
  "required": ["spec", "name", "version", "protocols", "capabilities", "endpoints"],
  "properties": {
    "spec": { "const": "agent-provider/v1" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "properties": {
        "id": { "type": ["string", "integer"] },
        "owner": { "type": "string" },
        "provider": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "protocols": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chain_id"],
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "environment": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "input_schema": { "type": ["object", "null"] },
          "output_schema": { "type": ["object", "null"] },
          "examples": { "type": "array" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "endpoints": {
      "type": "object",
      "description": "Provider-declared operation endpoints. URLs may be absolute or relative to the manifest URL and may contain {job_id} or {jobId} placeholders.",
      "properties": {
        "health": { "$ref": "#/$defs/operation" },
        "quote": { "$ref": "#/$defs/operation" },
        "decision": { "$ref": "#/$defs/operation" },
        "authorization": { "$ref": "#/$defs/operation" },
        "preflight": { "$ref": "#/$defs/operation" },
        "execute": { "$ref": "#/$defs/operation" },
        "result": { "$ref": "#/$defs/operation" }
      },
      "additionalProperties": { "$ref": "#/$defs/operation" }
    },
    "hiring": {
      "type": "object",
      "properties": {
        "protocol": { "type": "string" },
        "quote_required": { "type": "boolean" },
        "price": { "type": ["string", "number"] },
        "payment_token": { "type": "string" },
        "quote_ttl_seconds": { "type": "integer", "minimum": 1 },
        "terms": { "type": "object" }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "authorization": { "type": "string" },
        "mode": { "type": "string" },
        "wallet_scope": { "type": "string" },
        "state_changing": { "type": "boolean" },
        "user_approval_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "discovery": {
      "type": "object",
      "properties": {
        "canonical_url": { "type": "string", "format": "uri" },
        "agent_card": { "type": "string", "format": "uri" },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "operation": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
            },
            "methods": {
              "type": "array",
              "items": { "type": "string" }
            },
            "transport": { "type": "string" },
            "capability": { "type": "string" },
            "name": { "type": "string" },
            "input_schema": { "type": ["object", "null"] },
            "output_schema": { "type": ["object", "null"] },
            "authentication": { "type": "object" },
            "async": { "type": "boolean" },
            "metadata": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
