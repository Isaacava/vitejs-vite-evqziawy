{
  "crons": [
    {
      "path": "/api/index-agents",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/check-agent-endpoints",
      "schedule": "15 2 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/auth/nonce", "destination": "/api/auth?action=nonce" },
    { "source": "/api/auth/verify", "destination": "/api/auth?action=verify" },
    { "source": "/api/auth/me", "destination": "/api/auth?action=me" },
    { "source": "/api/auth/logout", "destination": "/api/auth?action=logout" },
    { "source": "/api/agent-actions", "destination": "/api/agent?route=actions" },
    { "source": "/api/agent-jobs/watch", "destination": "/api/agent?route=watch" },
    { "source": "/api/agent-runtimes/risk-guardian", "destination": "/api/agent?route=risk-runtime" },
    { "source": "/api/agent/heartbeat", "destination": "/api/agent?route=heartbeat" },
    { "source": "/api/risk-guardian", "destination": "/api/agent?route=risk-policy" },
    { "source": "/api/missions", "destination": "/api/dashboard?route=missions" },
    { "source": "/api/erc8183/prepare", "destination": "/api/erc8183" },
    { "source": "/api/testnet/erc8183-settlement", "destination": "/api/testnet?route=erc8183-settlement" },
    { "source": "/api/testnet/erc8183", "destination": "/api/testnet?route=erc8183" },
    { "source": "/api/testnet/job-status", "destination": "/api/testnet?route=job-status" },
    { "source": "/api/testnet/jobs-history", "destination": "/api/testnet?route=jobs-history" },
    { "source": "/api/testnet/match", "destination": "/api/testnet?route=match" },
    { "source": "/api/testnet/prepare-quote", "destination": "/api/testnet?route=prepare-quote" },
    { "source": "/api/testnet/providers", "destination": "/api/testnet?route=providers" },
    { "source": "/api/testnet/quotes", "destination": "/api/testnet?route=quotes" },
    { "source": "/api/testnet/recover-job", "destination": "/api/testnet?route=recover-job" },
    { "source": "/api/testnet/settle-plan", "destination": "/api/testnet?route=settle-plan" },
    { "source": "/api/testnet/sync-agent", "destination": "/api/testnet?route=sync-agent" },
    { "source": "/api/testnet/transaction-preflight", "destination": "/api/testnet?route=transaction-preflight" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/permissions", "destination": "/index.html" },
    { "source": "/agent/evidence", "destination": "/index.html" },
    { "source": "/prepare", "destination": "/index.html" },
    { "source": "/prepare/execute", "destination": "/index.html" },
    { "source": "/evaluator", "destination": "/index.html" },
    { "source": "/provider/submit", "destination": "/index.html" },
    { "source": "/lifecycle", "destination": "/index.html" },
    { "source": "/agents/register", "destination": "/index.html" },
    { "source": "/agent/inbox", "destination": "/index.html" }
  ]
}
