# AgentMarket environment
# Production MUST stay on BSC Mainnet.
VITE_APP_ENV=production
VITE_BSC_NETWORK=mainnet
VITE_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# WalletConnect
VITE_WALLETCONNECT_PROJECT_ID=SET_IN_VERCEL

# Only required by a dedicated VITE_APP_ENV=testnet build.
# Never copy these values into the production Vercel environment.
#
# The Testnet RPC is hard-pinned in src/lib/network.ts to avoid stale
# Vercel overrides pointing at the limited BNB seed endpoint.
# VITE_APP_ENV=testnet
# VITE_BSC_NETWORK=testnet
# VITE_ERC8183_COMMERCE_ADDRESS=0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
# VITE_ERC8183_ROUTER_ADDRESS=SET_NEW_TESTNET_ROUTER_AFTER_APEX_ROTATION
# VITE_ERC8183_POLICY_ADDRESS=SET_NEW_TESTNET_POLICY_AFTER_APEX_ROTATION
# VITE_ERC8004_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
