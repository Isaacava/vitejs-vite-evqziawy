# AgentMarket environment
# Production MUST stay on BSC Mainnet.
VITE_APP_ENV=production
VITE_BSC_NETWORK=mainnet
VITE_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# WalletConnect
VITE_WALLETCONNECT_PROJECT_ID=SET_IN_VERCEL

# Server-side settlement worker protection.
# CRON_SECRET is shared by the settlement worker endpoint and external scheduler.
# ERC8183_SETTLEMENT_PRIVATE_KEY is the dedicated BSC Testnet operator signer used
# only for permissionless router.settle(jobId) transactions. Never expose it to VITE_*.
CRON_SECRET=SET_STRONG_RANDOM_SECRET
ERC8183_SETTLEMENT_PRIVATE_KEY=SET_TESTNET_OPERATOR_PRIVATE_KEY

# External GitHub Actions worker trigger.
# This URL is the deployed AgentMarket origin, e.g. https://your-project.vercel.app
# It is stored as the GitHub Actions secret AGENTMARKET_BASE_URL.

# Only required by a dedicated VITE_APP_ENV=testnet build.
# Never copy these values into the production Vercel environment.
#
# The Testnet RPC is hard-pinned in src/lib/network.ts to avoid stale
# Vercel overrides pointing at the limited BNB seed endpoint.
# VITE_APP_ENV=testnet
# VITE_BSC_NETWORK=testnet
# VITE_ERC8183_COMMERCE_ADDRESS=0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
# VITE_ERC8183_ROUTER_ADDRESS=0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
# VITE_ERC8183_POLICY_ADDRESS=0x4f4678d4439fec812ac7674bb3efb4c8f5fb78a6
# VITE_ERC8004_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
